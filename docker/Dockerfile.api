# Multi-stage Dockerfile for a Go API.
# Builds ./cmd/api from the caller repository and produces a small runtime image.

FROM golang:1.25-alpine AS builder
RUN apk add --no-cache git

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags "-s -w" -o /out/app ./cmd/api


FROM alpine:3.18 AS runtime
LABEL org.opencontainers.image.title="go-api" \
      org.opencontainers.image.description="Go API runtime image" \
      org.opencontainers.image.authors="erivelto"

RUN apk add --no-cache ca-certificates curl && \
    addgroup -S app && adduser -S app -G app

WORKDIR /app
COPY --from=builder /out/app /app/app
RUN chown app:app /app/app

USER app

EXPOSE 8080
ENV PORT=8080

CMD ["./app"]
